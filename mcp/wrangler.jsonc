{
  // Yoww 的 MCP 接口。跟主站是两个完全独立的 Worker ——
  // 这边出任何问题都影响不到 yoww2026.cn。
  //
  // 部署：在这个目录里跑 `npx wrangler deploy`，就这一条命令，
  // 域名也一起绑好了，不用再去后台点。
  "name": "yoww-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",

  // 自定义域名写在这里，deploy 的时候 wrangler 自己去建 DNS 记录和绑定。
  // 写死成 mcp.yoww2026.cn 是为了跟站里那个页面、还有 Worker 里的自我介绍对上 ——
  // 三处是同一个地址，改的时候三处一起改，不然用户照着抄的地址是错的。
  "routes": [
    { "pattern": "mcp.yoww2026.cn", "custom_domain": true }
  ],

  // workers.dev 那个地址留着。域名万一没绑上，还有条路能先试。
  "workers_dev": true,

  "vars": {
    "SUPABASE_URL": "https://mejkhrxqdlybfatzecsc.supabase.co",

    // 自家图床的地址前缀。落在这个前缀下的图直接给原链接，不走中转 ——
    // 我们自己的桶没有防盗链，中转纯属浪费流量。
    "IMG_BASE": "https://img.yoww2026.cn",

    // 图片中转地址的签名密钥。它不保护任何数据 —— 中转出去的图本来
    // 站里人人看得见 —— 只是防止这个 Worker 变成谁都能白嫖的图片代理，
    // 一天把免费额度刷干净、把 MCP 一起拖挂。
    // 想换的话：Cloudflare 后台 → 这个 Worker → Settings → Variables，
    // 加一个同名的加密变量 IMG_SIGN_KEY，会盖掉这里的值。
    "IMG_SIGN_KEY": "aEW9U6xQEUAiOkw4IJBBtuCo6C6frA6Fq53phdDE",

    // 跟主站用的是同一把公开 key —— index.html 里就有一份，浏览器人人可见。
    // 它只说明"请求发给哪个项目"，不代表任何权限：
    // MCP 的内容函数第一个参数是用户令牌，没令牌光有这把 key 读不到任何东西。
    "SUPABASE_ANON_KEY": "sb_publishable_21TWA4F0KgENzkYF7TopFA_0G8mrbay"
  }
}
